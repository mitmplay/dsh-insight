# ============================================================
# .gitignore — things Git should never track
#
# Layman glossary: everything below is "machine-made stuff" —
# files that get regenerated by installing, building, or testing,
# or that are personal/local to this machine. Git only needs the
# hand-written source; all of this can be rebuilt from it.
# ============================================================

# --- Dependencies (installed by pnpm install) -----------------
# Think: "books borrowed from the library — re-borrow anytime."
node_modules/

# --- Build outputs (regenerated by vite build) ---------------
# Think: "the baked cake — you can always bake another from source."
/build
/dist
/.svelte-kit

# --- Translations, compiled (regenerated by vite build) ------
# paraglide compiled output (Three Tongues W1) - regenerated by vite build
src/lib/paraglide/

# --- Test artifacts (produced whenever tests run) ------------
# Think: "exam answer sheets — run the tests again and they reappear."
/coverage
/test-results
/playwright-report

# --- Scratch space (temporary work areas) --------------------
/tmp
# dsi-thin two-lane worktrees (removed at batch close)
.worktrees/
.playwright-mcp/

# --- Secrets & local settings (never publish these) ----------
# Think: "house keys — never leave copies in public."
.env
.env.*
# ...except the safe template everyone may see:
!.env.example

# --- Personal tool state -------------------------------------
# superdesign = local canvas state (never versioned).
# NOTE: .superpowers/ is NOT ignored on purpose — its sdd/ task
# ledgers (briefs, reports, diffs) are committed work records.
.superdesign

# --- Logs (crash/test chatter) -------------------------------
*.log

# --- SQLite transient sidecars -------------------------------
# Think: "scratch notes the database keeps while working; it
# tidies them away itself when done."
*.sqlite-shm
*.sqlite-wal

# --- Operating system junk -----------------------------------
# Think: "crumbs macOS leaves on every folder it touches."
.DS_Store
